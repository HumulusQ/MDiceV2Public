<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsTestProject>true</IsTestProject>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <!-- XUnit 测试框架 -->
    <PackageReference Include="xunit" Version="2.7.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.7">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.9.1" />

    <!-- 性能基准测试 -->
    <PackageReference Include="BenchmarkDotNet" Version="0.13.12" />

    <!-- Mock 和断言库 -->
    <PackageReference Include="Moq" Version="4.20.70" />
    <PackageReference Include="FluentAssertions" Version="6.12.0" />

    <!-- gRPC 测试支持 -->
    <PackageReference Include="Grpc.Net.Client.Web" Version="2.60.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MDiceV2.Core\MDiceV2.Core.csproj" />
    <ProjectReference Include="..\MDiceV2.Abstractions\MDiceV2.Abstractions.csproj" />
    <ProjectReference Include="..\Mods\AIMod\AIMod.csproj" />
  </ItemGroup>

</Project>
