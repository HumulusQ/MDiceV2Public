<Project Sdk="Microsoft.NET.Sdk">
  <!-- ============ 椤圭洰鍩烘湰淇℃伅 ============ -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Mod鐗瑰畾閰嶇疆 -->
    <!-- 杈撳嚭涓篋LL锛屽悕绉颁负CustomizedReply.dll -->
    <OutputType>Library</OutputType>
    <AssemblyName>CustomizedReply</AssemblyName>
    <!-- 鐗堟湰淇℃伅 -->
    <Version>0.2.7</Version>
    <Authors>YourName</Authors>
    <Description>A Mod example for MDiceV2 that provides customized reply functionality</Description>
    <!-- 涓嶇敓鎴怉ssemblyInfo锛屼娇鐢―irectory.Build.props -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <SelfContained>false</SelfContained>
    <AssemblyVersion>0.2.7</AssemblyVersion>
    <FileVersion>0.2.7</FileVersion>
    <InformationalVersion>beta</InformationalVersion>
  </PropertyGroup>
  <!-- ============ 椤圭洰渚濊禆 ============ -->
  <ItemGroup>
    <!-- 寮曠敤 Interfaces 浠ヨ幏鍙?IConfigurable 鎺ュ彛 -->
