    <!-- 寮曠敤 Core 浠ヨ幏鍙?Mod 鎺ュ彛瀹氫箟 -->
    <ProjectReference Include="..\..\MDiceV2.Core\MDiceV2.Core.csproj" />
  </ItemGroup>
  <!-- ============ Lua 鑴氭湰鎵ц寮曟搸 ============ -->
  <ItemGroup>
    <!-- MoonSharp: 绾疌#瀹炵幇鐨凩ua瑙ｉ噴鍣?-->
    <PackageReference Include="MoonSharp" Version="2.0.0" />
  </ItemGroup>
  <!-- ============ Avalonia 璧勬簮閰嶇疆 ============ -->
  <ItemGroup>
    <!-- 灏?Assets 鏂囦欢澶逛腑鐨勬墍鏈夎祫婧愭枃浠堕泦鎴愬埌绋嬪簭闆?-->
