+
+        private HashSet<string> ApplyResponseHeatGate(
+            HashSet<string> candidates,
+            long userId,
+            string speakerType,
+            bool isAted,
+            string content,
+            List<AiCharacterSession> sessions,
+            TeamSnapshot? team)
+        {
+            var qualified = new List<(AiCharacterSession Session, int Heat, int Score)>();
+            if (_trpgDb == null || sessions.Count == 0)
+                return new HashSet<string>(StringComparer.OrdinalIgnoreCase);
+
+            var groupAddressed = Regex.IsMatch(content, @"所有人|全员|大家|你们|全部", RegexOptions.IgnoreCase);
+            var isGmMessage = string.Equals(speakerType, "GM", StringComparison.OrdinalIgnoreCase);
+            var senderSession = sessions.FirstOrDefault(s => s.Character.VirtualId == userId);
+            if (senderSession != null)
+                return new HashSet<string>(StringComparer.OrdinalIgnoreCase);
+
+            foreach (var session in sessions)
+            {
+                if (session.RuntimeMode != AiRuntimeMode.Act)
+                    continue;
+
+                var characterId = session.Character.CharacterId;
+                var displayName = session.Character.DisplayName ?? "";
+                var heat = _trpgDb.GetAiResponseHeatAsync(session.Scope, characterId).GetAwaiter().GetResult();
+                var selected = candidates.Contains(characterId);
+                var directlyMentioned = !string.IsNullOrWhiteSpace(displayName) &&
+                    content.Contains(displayName, StringComparison.OrdinalIgnoreCase);
+                var singleAiGmPrompt = sessions.Count == 1 && isGmMessage;
+
+                var allow = heat switch
+                {
+                    < 45 => directlyMentioned || selected,
+                    < 70 => directlyMentioned || selected || groupAddressed || singleAiGmPrompt || (isAted && sessions.Count == 1),
+                    _ => directlyMentioned || selected || groupAddressed || singleAiGmPrompt || (isAted && sessions.Count == 1)
+                };
+
+                if (!allow)
+                    continue;
+
+                var score = heat;
+                if (directlyMentioned) score += 100;
+                if (selected) score += 40;
+                if (groupAddressed) score += 20;
+                qualified.Add((session, heat, score));
+            }
+
+            var maxActors = groupAddressed ? Math.Min(2, qualified.Count) : 1;
+            if (qualified.Count == 0 || maxActors <= 0)
+                return new HashSet<string>(StringComparer.OrdinalIgnoreCase);
+
+            return qualified
+                .OrderByDescending(x => x.Score)
+                .ThenByDescending(x => x.Heat)
+                .Take(maxActors)
+                .Select(x => x.Session.Character.CharacterId)
+                .ToHashSet(StringComparer.OrdinalIgnoreCase);
+        }
 
