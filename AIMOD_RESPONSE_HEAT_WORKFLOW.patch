+    public async Task<int> GetAiResponseHeatAsync(TrpgScope scope, string characterId)
+    {
+        using var cmd = _connection.CreateCommand();
+        cmd.CommandText = """
+            SELECT ResponseHeat
+            FROM AiCharacterRuntimeControl
+            WHERE WorldId = @worldId AND CharacterId = @characterId
+            LIMIT 1;
+            """;
+        cmd.Parameters.AddWithValue("@worldId", scope.WorldId);
+        cmd.Parameters.AddWithValue("@characterId", characterId);
+        var result = await cmd.ExecuteScalarAsync();
+        if (result == null || result == DBNull.Value)
+            return 45;
+        return Math.Clamp(Convert.ToInt32(result), 20, 100);
+    }
+
+    public async Task SetAiResponseHeatAsync(TrpgScope scope, string characterId, int heat, long updatedByUserId)
+    {
+        var clamped = Math.Clamp(heat, 20, 100);
+        using var cmd = _connection.CreateCommand();
+        cmd.CommandText = """
+            INSERT INTO AiCharacterRuntimeControl
+                (WorldId, CharacterId, ResponseHeat, UpdatedAt, UpdatedByUserId)
+            VALUES
+                (@worldId, @characterId, @responseHeat, @updatedAt, @updatedByUserId)
+            ON CONFLICT(WorldId, CharacterId) DO UPDATE SET
+                ResponseHeat = excluded.ResponseHeat,
+                UpdatedAt = excluded.UpdatedAt,
+                UpdatedByUserId = excluded.UpdatedByUserId;
+            """;
+        cmd.Parameters.AddWithValue("@worldId", scope.WorldId);
+        cmd.Parameters.AddWithValue("@characterId", characterId);
+        cmd.Parameters.AddWithValue("@responseHeat", clamped);
+        cmd.Parameters.AddWithValue("@updatedAt", DateTime.UtcNow.ToString("o"));
+        cmd.Parameters.AddWithValue("@updatedByUserId", updatedByUserId);
+        await cmd.ExecuteNonQueryAsync();
+    }
 
