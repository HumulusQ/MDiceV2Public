<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MDiceV2.Core.UI.ViewModels"
             xmlns:c="using:MDiceV2.Core.Converters"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="650"
             x:Class="MDiceV2.Core.UI.Views.ModManagerPanel"
             x:DataType="vm:ModManagerViewModel">
    <UserControl.Resources><c:NotConverter x:Key="NotConverter"/></UserControl.Resources>
    <Design.DataContext><vm:ModManagerViewModel/></Design.DataContext>

    <Grid RowDefinitions="Auto,Auto,*">
        <!-- Product header -->
        <Grid Grid.Row="0" ColumnDefinitions="10,*,Auto" Height="64" Margin="0,0,0,14">
            <Border Background="#E9B949"/>
            <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="EXTENSION LIBRARY" FontSize="9" Foreground="#7C86A3" LetterSpacing="1.8"/>
                <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="Black"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBox Text="{Binding SearchText, Mode=TwoWay}" Width="230" Height="38" Watermark="Search installed mods"/>
                <Button Width="38" Height="38" Padding="0" CornerRadius="2" Command="{Binding RefreshModsCommand}" ToolTip.Tip="Refresh library">
                    <Image Source="avares://MDiceV2.Core/Assets/Sprite/Reset.png" Width="16"/>
                </Button>
                <Button Height="38" Padding="14,0" CornerRadius="2" Background="#E9B949" BorderBrush="#E9B949"
                        Click="OnAddModClick" ToolTip.Tip="Install mod">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <Image Source="avares://MDiceV2.Core/Assets/Sprite/Add.png" Width="14"/>
                        <TextBlock Text="INSTALL" FontSize="9" Foreground="#181507" LetterSpacing="1"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
            <TextBlock Text="INSTALLED MODULES" FontSize="10" FontWeight="Bold" LetterSpacing="1.2" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="SELECT · ENABLE · MANAGE" FontSize="9" Foreground="#6F7892" LetterSpacing="1"/>
        </Grid>

        <Grid Grid.Row="2" IsVisible="{Binding IsEmptyState}" VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel Spacing="10" HorizontalAlignment="Center">
                <Grid Width="88" Height="70">
                    <Border Width="62" Height="54" Background="#202638" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
                    <Border Width="38" Height="38" Background="#E9B949" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                </Grid>
                <TextBlock Text="NO MODULES" FontSize="15" FontWeight="Black" LetterSpacing="1" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding EmptyMessage}" FontSize="11" Foreground="#7C86A3" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <ListBox Grid.Row="2" ItemsSource="{Binding FilteredModItems}" SelectedItem="{Binding SelectedMod, Mode=TwoWay}"
                 Background="Transparent" BorderThickness="0"
                 IsVisible="{Binding IsEmptyState, Converter={StaticResource NotConverter}}">
            <ListBox.Styles>
                <Style Selector="ListBoxItem"><Setter Property="Margin" Value="0,0,0,9"/><Setter Property="Padding" Value="0"/><Setter Property="Background" Value="Transparent"/></Style>
                <Style Selector="ListBoxItem:selected /template/ ContentPresenter"><Setter Property="Background" Value="Transparent"/></Style>
                <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="Transparent"/></Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Height="78" Background="#1A2030" BorderBrush="#2D354A" BorderThickness="1" CornerRadius="2">
                        <Grid ColumnDefinitions="8,Auto,*,Auto" Margin="0">
                            <Border Background="{Binding StateColor}"/>
                            <CheckBox Grid.Column="1" IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="16,0,12,0" VerticalAlignment="Center"/>
                            <Grid Grid.Column="2" RowDefinitions="Auto,Auto" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Black"/>
                                    <Border Background="#292F42" Padding="7,2" CornerRadius="1">
                                        <TextBlock Text="{Binding Version}" FontSize="9" Foreground="#A8B1C9"/>
                                    </Border>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12" Margin="0,6,0,0">
                                    <TextBlock Text="{Binding Author}" FontSize="10" Foreground="#909AB5"/>
                                    <TextBlock Text="{Binding ContainType}" FontSize="10" Foreground="#68718A"/>
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <Border Width="6" Height="6" CornerRadius="3" Background="{Binding StateColor}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding StateText}" FontSize="10" Foreground="{Binding StateColor}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="7" Margin="14,0" VerticalAlignment="Center">
                                <Button Height="34" MinWidth="74" Padding="12,0" CornerRadius="2" Click="OnToggleModStateClick"
                                        IsEnabled="{Binding CanToggle}">
                                    <TextBlock Text="{Binding ButtonText}" FontSize="9" FontWeight="Bold" LetterSpacing="0.8"/>
                                </Button>
                                <Button Height="34" Padding="12,0" CornerRadius="2" Click="OnOpenModFolderClick">
                                    <TextBlock Text="FOLDER" FontSize="9" LetterSpacing="0.8"/>
                                </Button>
                                <Button Height="34" Padding="12,0" CornerRadius="2" Background="#392126" BorderBrush="#6E333C" Click="OnRemoveModClick">
                                    <TextBlock Text="REMOVE" FontSize="9" Foreground="#FF8F92" LetterSpacing="0.8"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
