<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- 在最开始禁用工具集检查 -->
  <PropertyGroup>
    <_SkipToolsetVersionCheck>true</_SkipToolsetVersionCheck>
    <ToolsetNotFoundWarningSupression>true</ToolsetNotFoundWarningSupression>
  </PropertyGroup>

  <PropertyGroup>
    <_ProgramFilesX86 Condition="'$(_ProgramFilesX86)' == ''">$([System.Environment]::GetEnvironmentVariable('ProgramFiles(x86)'))</_ProgramFilesX86>
    <_ProgramFiles Condition="'$(_ProgramFiles)' == ''">$([System.Environment]::GetEnvironmentVariable('ProgramFiles'))</_ProgramFiles>
  </PropertyGroup>

  <PropertyGroup Condition="'$(VCTargetsPath)' == ''">
    <VCTargetsPath Condition="Exists('$(_ProgramFilesX86)\Microsoft Visual Studio\2022\BuildTools\MSBuild\Microsoft\VC\v170\')">$(_ProgramFilesX86)\Microsoft Visual Studio\2022\BuildTools\MSBuild\Microsoft\VC\v170\</VCTargetsPath>
    <VCTargetsPath Condition="'$(VCTargetsPath)' == '' and Exists('$(_ProgramFiles)\Microsoft Visual Studio\2022\BuildTools\MSBuild\Microsoft\VC\v170\')">$(_ProgramFiles)\Microsoft Visual Studio\2022\BuildTools\MSBuild\Microsoft\VC\v170\</VCTargetsPath>
    <VCTargetsPath Condition="'$(VCTargetsPath)' == '' and Exists('$(_ProgramFilesX86)\Microsoft Visual Studio\2022\Community\MSBuild\Microsoft\VC\v170\')">$(_ProgramFilesX86)\Microsoft Visual Studio\2022\Community\MSBuild\Microsoft\VC\v170\</VCTargetsPath>
    <VCTargetsPath Condition="'$(VCTargetsPath)' == '' and Exists('$(_ProgramFiles)\Microsoft Visual Studio\2022\Community\MSBuild\Microsoft\VC\v170\')">$(_ProgramFiles)\Microsoft Visual Studio\2022\Community\MSBuild\Microsoft\VC\v170\</VCTargetsPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(FrameworkPathOverride)' == '' and Exists('C:\Windows\Microsoft.NET\Framework64\v4.0.30319\mscorlib.dll')">
    <FrameworkPathOverride>C:\Windows\Microsoft.NET\Framework64\v4.0.30319\</FrameworkPathOverride>
  </PropertyGroup>

  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|Win32">
      <Configuration>Debug</Configuration>
      <Platform>Win32</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|Win32">
      <Configuration>Release</Configuration>
      <Platform>Win32</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>

  <PropertyGroup Label="Globals">
    <VCProjectVersion>16.0</VCProjectVersion>
    <ProjectGuid>{9D35CA5E-0061-F067-17B7-DFA6F3758F45}</ProjectGuid>
    <TargetFrameworkVersion>v4.7.2</TargetFrameworkVersion>
    <Keyword>ManagedCProj</Keyword>
    <RootNamespace>ABot.CLI</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
    <AssemblyName>ABot.CLI</AssemblyName>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />

  <PropertyGroup>
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <PlatformToolset Condition="'$(PlatformToolset)' == ''">v143</PlatformToolset>
    <CLRSupport>true</CLRSupport>
    <TrackFileAccess Condition="'$(MSBuildRuntimeType)' == 'Core' and '$(TrackFileAccess)' == ''">false</TrackFileAccess>
    <VCToolsInstallDir Condition="'$(VCToolsInstallDir)' == '' and '$(VCToolsVersion)' != '' and Exists('$(_ProgramFilesX86)\Microsoft Visual Studio\2022\BuildTools\VC\Tools\MSVC\$(VCToolsVersion)\')">$(_ProgramFilesX86)\Microsoft Visual Studio\2022\BuildTools\VC\Tools\MSVC\$(VCToolsVersion)\</VCToolsInstallDir>
    <VCToolsInstallDir Condition="'$(VCToolsInstallDir)' == '' and '$(VCToolsVersion)' != '' and Exists('$(_ProgramFiles)\Microsoft Visual Studio\2022\BuildTools\VC\Tools\MSVC\$(VCToolsVersion)\')">$(_ProgramFiles)\Microsoft Visual Studio\2022\BuildTools\VC\Tools\MSVC\$(VCToolsVersion)\</VCToolsInstallDir>
    <VCToolsInstallDir Condition="'$(VCToolsInstallDir)' == '' and '$(VCToolsVersion)' != '' and Exists('$(_ProgramFilesX86)\Microsoft Visual Studio\2022\Community\VC\Tools\MSVC\$(VCToolsVersion)\')">$(_ProgramFilesX86)\Microsoft Visual Studio\2022\Community\VC\Tools\MSVC\$(VCToolsVersion)\</VCToolsInstallDir>
    <VCToolsInstallDir Condition="'$(VCToolsInstallDir)' == '' and '$(VCToolsVersion)' != '' and Exists('$(_ProgramFiles)\Microsoft Visual Studio\2022\Community\VC\Tools\MSVC\$(VCToolsVersion)\')">$(_ProgramFiles)\Microsoft Visual Studio\2022\Community\VC\Tools\MSVC\$(VCToolsVersion)\</VCToolsInstallDir>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <DebugSymbols>true</DebugSymbols>
    <Optimization>Disabled</Optimization>
    <OutDir>$(SolutionDir)bin\Debug\x64\</OutDir>
    <IntDir>$(SolutionDir)obj\Debug\$(ProjectName)\x64\</IntDir>
    <AdditionalIncludeDirectories>$(ProjectDir);$(ProjectDir)..\ABot.Core\src;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    <PreprocessorDefinitions>_DEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    <RuntimeLibrary>MultiThreadedDebug</RuntimeLibrary>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <DebugSymbols>false</DebugSymbols>
    <Optimization>Full</Optimization>
    <OutDir>$(SolutionDir)bin\Release\x64\</OutDir>
    <IntDir>$(SolutionDir)obj\Release\$(ProjectName)\x64\</IntDir>
    <AdditionalIncludeDirectories>$(ProjectDir);$(ProjectDir)..\ABot.Core\src;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    <PreprocessorDefinitions>NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    <RuntimeLibrary>MultiThreaded</RuntimeLibrary>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|Win32'">
    <DebugSymbols>true</DebugSymbols>
    <Optimization>Disabled</Optimization>
    <OutDir>$(SolutionDir)bin\Debug\x86\</OutDir>
    <IntDir>$(SolutionDir)obj\Debug\$(ProjectName)\x86\</IntDir>
    <AdditionalIncludeDirectories>$(ProjectDir);$(ProjectDir)..\ABot.Core\src;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    <PreprocessorDefinitions>_DEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    <RuntimeLibrary>MultiThreadedDebug</RuntimeLibrary>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|Win32'">
    <DebugSymbols>false</DebugSymbols>
    <Optimization>Full</Optimization>
    <OutDir>$(SolutionDir)bin\Release\x86\</OutDir>
    <IntDir>$(SolutionDir)obj\Release\$(ProjectName)\x86\</IntDir>
    <AdditionalIncludeDirectories>$(ProjectDir);$(ProjectDir)..\ABot.Core\src;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    <PreprocessorDefinitions>NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    <RuntimeLibrary>MultiThreaded</RuntimeLibrary>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />

  <Target Name="CustomBuild"
          Condition="'$(MSBuildRuntimeType)' == 'Core' and '@(CustomBuild)' == '' and '@(CustomBuildStep)' == ''" />
  <Target Name="CopyFileToFolders"
          Condition="'$(MSBuildRuntimeType)' == 'Core'" />

  <ItemGroup>
    <ClCompile Include="ABotInterop.cpp" />
  </ItemGroup>

  <ItemGroup>
    <ClInclude Include="ABotInterop.h" />
  </ItemGroup>

  <!-- 引用ABot.Core库 -->
  <ItemGroup>
    <ProjectReference Include="..\ABot.Core\ABot.Core.vcxproj">
      <Project>{8D35CA5E-0061-F067-17B7-DFA6F3758F45}</Project>
    </ProjectReference>
  </ItemGroup>

  <!-- C++/CLI项目的标准属性 -->
  <PropertyGroup>
    <CLRSupport>true</CLRSupport>
    <WarningLevel>3</WarningLevel>
  </PropertyGroup>

  <!-- Disable CET compatibility for Windows 10 21H2 compatibility -->
  <ItemDefinitionGroup>
    <Link>
      <AdditionalLibraryDirectories>$(IntDir);%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalOptions>/CETCOMPAT:NO %(AdditionalOptions)</AdditionalOptions>
    </Link>
  </ItemDefinitionGroup>

  <Target Name="GenerateLocalMscoreeImportLib" BeforeTargets="Link" Condition="Exists('$(ProjectDir)MSCOREE.def') and !Exists('$(IntDir)MSCOREE.lib')">
    <MakeDir Directories="$(IntDir)" />
    <Exec Command="&quot;$(VCToolsInstallDir)bin\Hostx64\x64\lib.exe&quot; /def:&quot;$(ProjectDir)MSCOREE.def&quot; /machine:x64 /out:&quot;$(IntDir)MSCOREE.lib&quot;" />
  </Target>

  <!-- 禁用 MSB8020 工具集检查错误 -->
  <Target Name="DisableToolsetCheck" BeforeTargets="PrepareForBuild">
    <PropertyGroup>
      <_SkipToolsetVersionCheck>true</_SkipToolsetVersionCheck>
    </PropertyGroup>
  </Target>

</Project>
